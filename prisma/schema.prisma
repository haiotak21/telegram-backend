generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(cuid())
  userId              String        @unique
  telegramId          String?       @unique
  chatId              String?
  username            String?
  balance             Float         @default(0)
  currency            String        @default("USDT")
  kycStatus           String        @default("not_started")
  strowalletCustomerId String?
  firstName           String?
  lastName            String?
  dateOfBirth         String?
  phoneNumber         String?
  customerEmail       String?
  line1               String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  houseNumber         String?
  idType              String?
  idNumberEncrypted   String?
  idNumberLast4       String?
  idImageUrl          String?
  idImageFrontUrl     String?
  idImageBackUrl      String?
  idImagePdfUrl       String?
  userPhotoUrl        String?
  kycSubmittedAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactions        Transaction[]

  @@index([kycStatus])
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  transactionType   String   @default("deposit")
  paymentMethod     String
  amount            Float
  currency          String?
  amountEtb         Float?
  amountUsdt        Float?
  feeEtb            Float?
  feeUsdt           Float?
  rateSnapshot      Float?
  transactionNumber String?
  referenceNumber   String?
  status            String   @default("pending")
  verified          Boolean  @default(false)
  responseData      Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([transactionType])
  @@index([status])
  @@unique([transactionType, transactionNumber, userId])
  @@unique([transactionType, referenceNumber, userId])
}

model Card {
  id               String   @id @default(cuid())
  cardId            String   @unique
  userId            String?
  customerEmail     String?
  nameOnCard        String?
  cardType          String?
  status            String?
  last4             String?
  currency          String?
  balance           String?
  availableBalance  String?
  lastSync          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([userId, customerEmail, cardId])
}

model CardRequest {
  id             String   @id @default(cuid())
  userId         String
  nameOnCard     String?
  cardType       String?
  amount         String?
  customerEmail  String?
  mode           String?
  status         String   @default("pending")
  adminNote      String?
  decisionReason String?
  cardId         String?
  cardNumber     String?
  cvc            String?
  responseData   Json?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status, createdAt])
}
