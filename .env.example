PORT=3000

# Supabase Postgres
USE_PRISMA_PERSISTENCE=true
# Optional test override (defaults to false in test runs)
USE_PRISMA_PERSISTENCE_IN_TESTS=false
# Runtime URL (can be transaction pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Prisma schema URL (use direct or session pooler)
DIRECT_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Legacy MongoDB (kept during migration)
MONGODB_URI=
# Optional: enable only if you intentionally want dual reads/writes during migration
ENABLE_MONGO_FALLBACK=false
# One-time restore source for migrate:mongo-to-supabase
MIGRATION_MONGODB_URI=

# Telegram bot lock strategy during migration
# Set false to allow bot polling without Mongo-backed BotLock
TELEGRAM_BOT_USE_DB_LOCK=true

